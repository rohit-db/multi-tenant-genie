# Edge gateway config — copy to edge/.env and fill in (edge/.env is gitignored).
#
# The edge is the Firefly-style "front door": it hosts your public origin,
# keeps the app session cookie, and reverse-proxies into the Databricks App
# using an edge Service Principal token so end users never see Databricks SSO.

# --- Upstream Databricks App (behind the Apps OAuth proxy) -------------------
# The deployed app URL. Get it with:
#   databricks apps get multi-tenant-genie -p <profile> | jq -r .url
EDGE_UPSTREAM_URL=https://multi-tenant-genie-XXXX.aws.databricksapps.com

# --- Workspace OIDC endpoint (mints the edge SP token) -----------------------
# The workspace host, NOT the app URL. Tokens are minted at
# <EDGE_WORKSPACE_HOST>/oidc/v1/token.
EDGE_WORKSPACE_HOST=https://<your-workspace>.cloud.databricks.com

# --- Edge Service Principal --------------------------------------------------
# An SP that has CAN_USE on the Databricks App above. This is the credential
# the edge presents to clear the Apps OAuth proxy.
EDGE_SP_CLIENT_ID=
EDGE_SP_CLIENT_SECRET=

# --- Edge listener -----------------------------------------------------------
EDGE_HOST=127.0.0.1
EDGE_PORT=9000

# --- Local-http cookie handling ----------------------------------------------
# Strip `Secure` from upstream Set-Cookie so the mtg_session cookie survives
# over http://localhost. Set to false (0) for any real https edge deployment.
EDGE_REWRITE_SECURE_COOKIES=1

# OAuth scope for the edge SP token (default all-apis; matches the app path).
EDGE_OAUTH_SCOPE=all-apis
