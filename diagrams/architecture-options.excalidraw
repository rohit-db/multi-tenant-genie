    {
      "id": "04wjlNgH3E3chNW7VA3c1",
      "type": "text",
      "x": 1439.042208758803,
      "y": 2259.7756685073496,
      "width": 1220.077508602929,
      "height": 88.60819301335182,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 1053705323,
      "version": 417,
      "versionNonce": 505364267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774963913711,
      "link": null,
      "locked": false,
      "text": "What is Azure AD B2C? It's Microsoft's \"identity-as-a-service\" platform. \nInstead of BCD Travel building their own login/signup/password-reset system, they outsource that entire problem to Azure. \nAzure B2C acts as the trusted middleman: it handles authentication, stores customer identities, and issues tokens that BCD's apps accept.\n",
      "fontSize": 17.721638602670378,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is Azure AD B2C? It's Microsoft's \"identity-as-a-service\" platform. \nInstead of BCD Travel building their own login/signup/password-reset system, they outsource that entire problem to Azure. \nAzure B2C acts as the trusted middleman: it handles authentication, stores customer identities, and issues tokens that BCD's apps accept.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
